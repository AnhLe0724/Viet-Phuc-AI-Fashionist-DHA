# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU - VIỆT PHỤC AI
# Hãy đổi tên hoặc sao chép file này thành .env và điền API Key của bạn
# ==========================================

# Cổng khởi chạy Server (mặc định 3001)
PORT=3001
CLIP_PORT=5005

# 1. API Text-To-Text (Dùng cho AI Stylist Chatbot tư vấn cổ phục)
TEXT_API_BASE_URL=https://api.vilao.ai/v1
TEXT_API_MODEL=ram/gemini-3.6-flash-high
TEXT_API_KEY=your_text_api_key_here

# 2. API Image-To-Image (Dùng cho tính năng Phối Đồ Bằng AI trên người mẫu)
IMAGE_API_BASE_URL=https://api.vilao.ai/v1
IMAGE_API_MODEL=veo/gemini-3.0-pro-image
IMAGE_API_KEY=your_image_api_key_here
